# Normalize line endings in the repository; Windows tools get CRLF on checkout.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.props   text
*.slnx    text
*.resx    text
*.json    text
*.md      text
*.yml     text
*.iss     text

*.png     binary
*.ico     binary
*.sqlite  binary
*.bin     binary
*.gz      binary

# The web workspace is formatted by Prettier (LF): keep LF on every checkout, Windows included.
src/web/** text=auto eol=lf
