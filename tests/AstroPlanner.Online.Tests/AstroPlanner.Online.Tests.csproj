<Project Sdk="Microsoft.NET.Sdk">

  <!-- Recorded/stubbed HTTP responses only: tests never touch the real network. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AstroPlanner.Online\AstroPlanner.Online.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ManualTimeProvider.cs" Link="Shared\ManualTimeProvider.cs" />
    <Compile Include="..\Shared\StubHttpHandler.cs" Link="Shared\StubHttpHandler.cs" />
  </ItemGroup>

  <!-- Responses recorded from the real services (see tests/fixtures/online/README.md); never fetched by tests. -->
  <ItemGroup>
    <None Include="..\fixtures\online\*.json;..\fixtures\online\*.xml;..\fixtures\online\*.jpg" Link="fixtures\online\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AstroPlanner.Testing" />
  </ItemGroup>

</Project>
