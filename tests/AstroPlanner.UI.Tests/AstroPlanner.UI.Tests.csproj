<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows to test the WPF view models and services of AstroPlanner.UI. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- NU1701: SkiaSharp.Views.WPF, inherited from AstroPlanner.UI (see its project file). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AstroPlanner.Application\AstroPlanner.Application.csproj" />
    <ProjectReference Include="..\..\src\AstroPlanner.Core\AstroPlanner.Core.csproj" />
    <ProjectReference Include="..\..\src\AstroPlanner.Data\AstroPlanner.Data.csproj" />
    <ProjectReference Include="..\..\src\AstroPlanner.Online\AstroPlanner.Online.csproj" />
    <ProjectReference Include="..\..\src\AstroPlanner.UI\AstroPlanner.UI.csproj" />
    <!-- Only for the architecture rules: nothing in the app may depend on the data tool. -->
    <ProjectReference Include="..\..\tools\AstroPlanner.DataBuilder\AstroPlanner.DataBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <!-- TestShell and the fakes live with the view-model tests; the host tests use them too. -->
    <Compile Include="..\AstroPlanner.Application.Tests\TestDoubles.cs" Link="Shared\TestDoubles.cs" />
  </ItemGroup>

  <!-- Files written by AstroPlanner v1, for the import service tests. -->
  <ItemGroup>
    <None Include="..\fixtures\v1\**\*.json" Link="fixtures\v1\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A real DSS HiPS tile (tests/fixtures/online/README.md), for the framing preview end to end. -->
  <ItemGroup>
    <None Include="..\fixtures\online\hips-dsscolor-norder5-npix115.jpg" Link="fixtures\online\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AstroPlanner.Testing" />
    <Using Include="AstroPlanner.Core.Models" />
    <Using Include="AstroPlanner.Core.Interfaces" />
    <Using Include="AstroPlanner.Application.Services" />
    <Using Include="AstroPlanner.Application.Sky" />
    <Using Include="AstroPlanner.Application.Tests" />
  </ItemGroup>

</Project>
