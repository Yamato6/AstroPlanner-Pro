<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AstroPlanner.Core\AstroPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestCatalog.cs" Link="Shared\TestCatalog.cs" />
  </ItemGroup>

  <!-- JPL Horizons golden fixtures (tools/fetch-horizons-fixtures.ps1); never fetched by tests. -->
  <ItemGroup>
    <None Include="..\fixtures\horizons\*.csv" Link="fixtures\horizons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- HEALPix reference from astropy-healpix (tools/generate-healpix-fixture.py). -->
    <None Include="..\fixtures\healpix\*.csv" Link="fixtures\healpix\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AstroPlanner.Testing" />
  </ItemGroup>

</Project>
