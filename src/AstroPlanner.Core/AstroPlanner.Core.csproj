<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure domain: BCL only. No IO, UI or HTTP (enforced by the architecture tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Small reference tables (read from the assembly, never from disk). See data/SOURCES.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Algorithms\Data\*.dat" LogicalName="AstroPlanner.Core.Data.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
