<Window x:Class="AstroPlanner.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AstroPlanner.Application.Resources;assembly=AstroPlanner.Application"
        Title="{x:Static res:Strings.AboutWindowTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NightTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NightMutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="CreditStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NightTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28">
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/AstroPlannerPro;component/Assets/AstroPlanner.png" Width="56" Height="56" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource HighlightTextBrush}" Text="{x:Static res:Strings.AppName}"/>
                <TextBlock Foreground="{DynamicResource NightMutedTextBrush}">
                    <Run Text="{x:Static res:Strings.AboutVersion}"/> <Run x:Name="VersionRun"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" Text="{x:Static res:Strings.AboutDescription}"/>

        <TextBlock Style="{StaticResource SectionStyle}" Text="{x:Static res:Strings.AboutCredits}"/>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutCloudForecast}"/>
            <Hyperlink NavigateUri="https://open-meteo.com/" RequestNavigate="OnLinkClicked">Open-Meteo.com</Hyperlink>
            <Run Text="{x:Static res:Strings.AboutCloudForecastLicense}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutOnlineData}"/>
            <Run Text="{x:Static res:Strings.AboutOnlineDataText}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutCatalogs}"/>
            <Run Text="{x:Static res:Strings.AboutCatalogsText}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutLightPollution}"/>
            <Run Text="{x:Static res:Strings.AboutLightPollutionText}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutAlgorithms}"/>
            <Run Text="{x:Static res:Strings.AboutAlgorithmsText}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource CreditStyle}">
            <Run FontWeight="SemiBold" Text="{x:Static res:Strings.AboutLibraries}"/>
            <Run Text="{x:Static res:Strings.AboutLibrariesText}"/>
        </TextBlock>

        <TextBlock Style="{StaticResource SectionStyle}" Text="{x:Static res:Strings.AboutYourData}"/>
        <TextBlock Text="{x:Static res:Strings.AboutYourDataText}"/>
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.AboutOpenFolder}"
                    Click="OnOpenDataFolderClicked"/>
            <TextBlock x:Name="DataFolderText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource NightMutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>

        <TextBlock Style="{StaticResource SectionStyle}" Text="{x:Static res:Strings.AboutLicense}"/>
        <TextBlock>
            <Run Text="{x:Static res:Strings.AboutLicenseText}"/>
            <LineBreak/>
            <Hyperlink NavigateUri="https://github.com/Yamato6/AstroPlanner-Pro" RequestNavigate="OnLinkClicked"><Run Text="{x:Static res:Strings.AboutRepositoryText}"/></Hyperlink>
        </TextBlock>

        <TextBlock Style="{StaticResource SectionStyle}" Text="{x:Static res:Strings.AboutShortcuts}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,3" FontWeight="SemiBold" Text="Ctrl+F"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static res:Strings.ShortcutSearch}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,3" FontWeight="SemiBold" Text="F5"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.ShortcutNow}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,3" FontWeight="SemiBold" Text="Ctrl+,"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static res:Strings.ShortcutSettings}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,10,3" FontWeight="SemiBold" Text="Ctrl+P"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.ShortcutPrint}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,10,3" FontWeight="SemiBold" Text="Ctrl+E"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Static res:Strings.ShortcutExport}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,10,3" FontWeight="SemiBold" Text="F1"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Static res:Strings.ShortcutAbout}"/>
        </Grid>

        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.Close}" HorizontalAlignment="Right"
                Margin="0,22,0,0" MinWidth="90" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
