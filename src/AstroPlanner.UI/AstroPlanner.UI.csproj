<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF application and composition root: the only project allowed to reference every layer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NU1701: SkiaSharp.Views.WPF (a ScottPlot.WPF dependency) only declares .NET Framework
         but works on modern .NET; known ScottPlot warning. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <AssemblyName>AstroPlannerPro</AssemblyName>
    <RootNamespace>AstroPlanner.UI</RootNamespace>
    <ApplicationIcon>Assets\AstroPlanner.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- CI replaces the version with the tag's (e.g. 2.0.0-rc.1). -->
    <Version>2.0.0</Version>
    <AssemblyTitle>AstroPlanner Pro</AssemblyTitle>
    <Description>Astrophotography planner: what to shoot tonight, when, with which gear and how likely it is to work.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroPlanner.Core\AstroPlanner.Core.csproj" />
    <ProjectReference Include="..\AstroPlanner.Data\AstroPlanner.Data.csproj" />
    <ProjectReference Include="..\AstroPlanner.Online\AstroPlanner.Online.csproj" />
    <ProjectReference Include="..\AstroPlanner.SkyBridge\AstroPlanner.SkyBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="ScottPlot.WPF" />
    <!-- Lifts PDFsharp's vulnerable transitive dependency (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- Domain types used everywhere in the UI (also by the WPF-generated code). -->
  <ItemGroup>
    <Using Include="AstroPlanner.Core.Models" />
    <Using Include="AstroPlanner.Core.Interfaces" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AstroPlanner.png" />
  </ItemGroup>

  <!-- UI strings live in Resources/Strings.resx (embedded as AstroPlanner.UI.Resources.Strings).
       A strongly typed class, AstroPlanner.UI.Resources.Strings, is generated before every
       compilation, including WPF's temporary markup assembly, so that both C# code and XAML
       ({x:Static res:Strings.Key}) can use it. The Visual Studio custom tool is not needed. -->
  <Target Name="GenerateStringsClass" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <StringsDesignerFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Strings.Designer.cs'))</StringsDesignerFile>
    </PropertyGroup>
    <GenerateResource Sources="Resources\Strings.resx"
                      OutputResources="$(IntermediateOutputPath)StringsClass.resources"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="AstroPlanner.UI.Resources"
                      StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="AstroPlanner.UI.Resources"
                      StronglyTypedFileName="$(StringsDesignerFile)"
                      PublicClass="true"
                      ExecuteAsTool="false" />
    <ItemGroup>
      <!-- Whatever its spelling (relative or absolute), keep a single copy of the generated file. -->
      <Compile Remove="@(Compile)" Condition="'%(Filename)%(Extension)' == 'Strings.Designer.cs'" />
      <Compile Include="$(StringsDesignerFile)" />
    </ItemGroup>
  </Target>

  <!-- Sky renderer (src/sky-renderer, TypeScript + three.js) and its data (data/build/sky) are
       packed into one zip embedded in the exe; SkyAssets extracts it at run time and WebView2
       serves it from https://app.astroplanner/ and https://data.astroplanner/ (docs/sky-renderer.md).
       Needs Node.js; pass -p:SkipSkyRendererBuild=true to build without it (the Sky tab then
       falls back to the 2D chart unless a previous build left src/sky-renderer/dist). -->
  <PropertyGroup>
    <SkyRendererDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\sky-renderer'))\</SkyRendererDirectory>
    <SkyDataDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\data\build\sky'))\</SkyDataDirectory>
    <!-- BaseIntermediateOutputPath (obj\) is already defined here; IntermediateOutputPath is not yet. -->
    <SkyAssetsStaging>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)sky-assets\</SkyAssetsStaging>
    <SkyAssetsZip>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)sky-assets.zip</SkyAssetsZip>
  </PropertyGroup>

  <ItemGroup>
    <SkyRendererSource Include="$(SkyRendererDirectory)src\**\*;$(SkyRendererDirectory)index.html;$(SkyRendererDirectory)package-lock.json;$(SkyRendererDirectory)vite.config.ts;$(SkyRendererDirectory)tsconfig.json" />
    <SkyDataFile Include="$(SkyDataDirectory)*.bin;$(SkyDataDirectory)star-names.json;$(SkyDataDirectory)dsos.json;$(SkyDataDirectory)constellation-labels.json" />
  </ItemGroup>

  <Target Name="BuildSkyRenderer"
          Condition="'$(SkipSkyRendererBuild)' != 'true'"
          Inputs="@(SkyRendererSource)"
          Outputs="$(SkyRendererDirectory)dist\index.html">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(SkyRendererDirectory)" Condition="!Exists('$(SkyRendererDirectory)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(SkyRendererDirectory)" />
  </Target>

  <Target Name="PackSkyAssets"
          DependsOnTargets="BuildSkyRenderer"
          Condition="Exists('$(SkyRendererDirectory)dist\index.html')"
          Inputs="@(SkyDataFile);$(SkyRendererDirectory)dist\index.html"
          Outputs="$(SkyAssetsZip)">
    <ItemGroup>
      <SkyAppFile Include="$(SkyRendererDirectory)dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(SkyAssetsStaging)" />
    <Copy SourceFiles="@(SkyAppFile)" DestinationFiles="@(SkyAppFile->'$(SkyAssetsStaging)app\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SkyDataFile)" DestinationFolder="$(SkyAssetsStaging)data" />
    <ZipDirectory SourceDirectory="$(SkyAssetsStaging)" DestinationFile="$(SkyAssetsZip)" Overwrite="true" />
  </Target>

  <Target Name="EmbedSkyAssets" DependsOnTargets="PackSkyAssets" BeforeTargets="BeforeBuild">
    <ItemGroup Condition="Exists('$(SkyAssetsZip)')">
      <EmbeddedResource Include="$(SkyAssetsZip)" LogicalName="AstroPlanner.UI.Sky.sky-assets.zip" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="AstroPlanner.UI.Tests" />
  </ItemGroup>

</Project>
