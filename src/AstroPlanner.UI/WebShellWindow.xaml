<Window x:Class="AstroPlanner.UI.WebShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AstroPlanner.Application.Resources;assembly=AstroPlanner.Application"
        xmlns:sky="clr-namespace:AstroPlanner.UI.Sky"
        Title="{x:Static res:Strings.MainWindowTitle}"
        Height="800" Width="1400" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The v3 planetarium UI (opened with the ui=web switch, in development until v3.0.0): one WebView2 filling the
         window; everything is drawn by the web page (src/web/apps/planetarium). -->
    <sky:SkyHost x:Name="SkyHostView"/>
</Window>
