<Window x:Class="AstroPlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:converters="clr-namespace:AstroPlanner.UI.Converters"
        xmlns:res="clr-namespace:AstroPlanner.UI.Resources"
        xmlns:sky="clr-namespace:AstroPlanner.UI.Sky"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.MainWindowTitle}"
        Height="800" Width="1400" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Shared colors and styles: Themes/Dark.xaml -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToTextConverter x:Key="ObservedMarkConverter" TrueText="✓" FalseText=""/>
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True"/>
        <converters:DisplayNameConverter x:Key="DisplayNameConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:RgbImageConverter x:Key="RgbImageConverter"/>
        <converters:ImageBytesConverter x:Key="ImageBytesConverter"/>
        <converters:BooleanToTextConverter x:Key="ActiveMarkConverter" TrueText="●" FalseText=""/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}"/>
        <!-- Segmented buttons of the sky view modes (3D / all-sky / finder) -->
        <Style x:Key="SkyModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource StrongTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource DarkFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBorderBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ObservedCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessSoftBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.ObservedTooltip}"/>
        </Style>
        <Style x:Key="NumericCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PaddedNumericCellStyle" TargetType="TextBlock" BasedOn="{StaticResource NumericCellStyle}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- Distance to the Moon: orange when the Moon, bright and close, interferes -->
        <Style x:Key="MoonCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.MoonDistanceTooltip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MoonInterferes}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="{x:Static res:Strings.MoonInterferesTooltip}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Variants for "My plan", whose rows expose the object in Row -->
        <Style x:Key="PlanMoonCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.MoonDistanceTooltip}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.MoonInterferes}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="{x:Static res:Strings.MoonInterferesTooltip}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlanStatusCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.IsVisible}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Feasibility verdict: green when good, amber when marginal, red when unlikely or impossible -->
        <Style x:Key="VerdictCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource NightMutedTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="Excellent">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource SuccessSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Marginal">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Unlikely">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="NotPossible">
                    <Setter Property="Foreground" Value="{StaticResource PlaceholderTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- New version banner (only when there is one) -->
        <Border Grid.Row="2" Margin="0,0,0,4" Padding="12,8" CornerRadius="6" Background="{StaticResource BannerBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.UpdateNotNow}"
                        Command="{Binding DismissUpdateCommand}"/>
                <TextBlock VerticalAlignment="Center" Foreground="White">
                    <Run Text="{Binding UpdateBannerText, Mode=OneWay}"/>
                    <Hyperlink NavigateUri="{Binding AvailableUpdate.Url}" RequestNavigate="OnLinkClicked"><Run Text="{x:Static res:Strings.UpdateDownload}"/></Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Header: observer summary and observation date -->
        <Border Grid.Row="0" Padding="12" Background="{StaticResource NightPanelBrush}" CornerRadius="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="{x:Static res:Strings.AppName}"/>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" FontSize="12" Text="{x:Static res:Strings.AppTagline}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Foreground="{StaticResource TabTextBrush}" Text="{x:Static res:Strings.HeaderLocalDateTime}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <DatePicker Width="124" Style="{StaticResource DarkDatePickerStyle}"
                                    AutomationProperties.Name="{x:Static res:Strings.HeaderObservationDate}"
                                    SelectedDate="{Binding ObservationDate}"/>
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  Width="58" Margin="6,0,0,0" MaxDropDownHeight="240"
                                  ToolTip="{x:Static res:Strings.HeaderHour}"
                                  AutomationProperties.AutomationId="HourCombo" AutomationProperties.Name="{x:Static res:Strings.HeaderHour}"
                                  ItemsSource="{Binding Hours}" ItemStringFormat="00"
                                  SelectedItem="{Binding ObservationHour}"/>
                        <TextBlock Text=":" Foreground="White" Margin="3,0" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  Width="58" MaxDropDownHeight="240"
                                  ToolTip="{x:Static res:Strings.HeaderMinute}"
                                  AutomationProperties.AutomationId="MinuteCombo" AutomationProperties.Name="{x:Static res:Strings.HeaderMinute}"
                                  ItemsSource="{Binding Minutes}" ItemStringFormat="00"
                                  SelectedItem="{Binding ObservationMinute}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                Content="{x:Static res:Strings.HeaderOneHourEarlier}" ToolTip="{x:Static res:Strings.HeaderOneHourEarlierTooltip}"
                                Command="{Binding ShiftObservationTimeCommand}" CommandParameter="-60"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{x:Static res:Strings.HeaderOneHourLater}" ToolTip="{x:Static res:Strings.HeaderOneHourLaterTooltip}"
                                Command="{Binding ShiftObservationTimeCommand}" CommandParameter="60"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Foreground="{StaticResource TabTextBrush}" Text="{x:Static res:Strings.HeaderTimeZone}"/>
                    <TextBlock Foreground="White" Text="{Binding Observer.TimeZoneId}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Foreground="{StaticResource TabTextBrush}" Text="{x:Static res:Strings.HeaderActiveLocation}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="White" Text="{Binding ActiveLocationName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveLocationName}"/>
                    <TextBlock Foreground="{StaticResource TabTextBrush}" Text="{Binding LocationSummary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Active rig (spec §10): drives the camera frame and the feasibility verdicts -->
                <StackPanel Grid.Column="4" Margin="0,0,14,0"
                            Visibility="{Binding Equipment, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Foreground="{StaticResource TabTextBrush}" Text="{x:Static res:Strings.HeaderActiveRig}"/>
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="220" Margin="0,2,0,0"
                              AutomationProperties.AutomationId="ActiveRigCombo" AutomationProperties.Name="{x:Static res:Strings.HeaderActiveRig}"
                              ToolTip="{x:Static res:Strings.HeaderActiveRigTooltip}"
                              ItemsSource="{Binding Equipment.Rigs}" DisplayMemberPath="Name"
                              SelectedValuePath="Rig.Id" SelectedValue="{Binding Equipment.ActiveRigId}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15" Foreground="{StaticResource TabTextBrush}"
                               Text="{Binding OnlineStatusGlyph}" ToolTip="{Binding OnlineStatusTooltip}"
                               AutomationProperties.Name="{Binding OnlineStatusText}" AutomationProperties.HelpText="{x:Static res:Strings.OnlineStatusName}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.HeaderSettings}" Click="OnSettingsClicked"
                            ToolTip="{x:Static res:Strings.HeaderSettingsTooltip}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Targets.ResetFiltersCommand}" Content="{x:Static res:Strings.HeaderReset}"
                            ToolTip="{x:Static res:Strings.HeaderResetTooltip}"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.HeaderNow}" Command="{Binding SetNowCommand}"
                            ToolTip="{x:Static res:Strings.HeaderNowTooltip}"/>
                    <CheckBox VerticalAlignment="Center" Margin="12,0,0,0" Foreground="White" Content="{x:Static res:Strings.HeaderLive}"
                              IsChecked="{Binding IsLive}"
                              ToolTip="{x:Static res:Strings.HeaderLiveTooltip}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Content="?" Width="34"
                            Click="OnAboutClicked" ToolTip="{x:Static res:Strings.HeaderAboutTooltip}"
                            AutomationProperties.Name="{x:Static res:Strings.HeaderAboutName}"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardCatalogObjects}"/>
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="{Binding Targets.CatalogCount}"/>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" FontSize="12" Text="{Binding Tonight.ObservedSummaryText}"
                               ToolTip="{x:Static res:Strings.CardObservedTooltip}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardVisibleObjects}"/>
                    <TextBlock Foreground="{StaticResource SuccessSoftBrush}" FontSize="24" FontWeight="SemiBold" Text="{Binding Targets.VisibleObjectsCount}"/>
                </StackPanel>
            </Border>
            <!-- Dark night: end → start of astronomical twilight (Sun at -18°) -->
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0"
                    ToolTip="{x:Static res:Strings.CardDarkNightTooltip}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardDarkNight}"/>
                    <TextBlock Foreground="{StaticResource DarknessBrush}" FontSize="24" FontWeight="SemiBold" Text="{Binding Tonight.DarkNightText}"/>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" FontSize="12" Text="{Binding Tonight.SunTimesText}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Tonight.SunTimesText}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0"
                    ToolTip="{x:Static res:Strings.CardMoonTooltip}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardMoon}"/>
                    <TextBlock Foreground="{StaticResource MoonBrush}" FontSize="24" FontWeight="SemiBold" Text="{Binding Tonight.MoonIlluminationText}"/>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" FontSize="12" Text="{Binding Tonight.MoonDetailText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <!-- Cloud forecast during the dark night (Open-Meteo) -->
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0"
                    ToolTip="{Binding Tonight.CloudDetailText}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardClouds}"/>
                    <TextBlock Foreground="{StaticResource LabelTextBrush}" FontSize="24" FontWeight="SemiBold" Text="{Binding Tonight.CloudCoverText}"/>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" FontSize="12" Text="{Binding Tonight.CloudDetailText}" TextTrimming="CharacterEllipsis"/>
                    <!-- Attribution required by the Open-Meteo CC BY 4.0 license -->
                    <TextBlock FontSize="10" Margin="0,2,0,0" Foreground="{StaticResource PlaceholderTextBrush}">
                        <Run Text="{x:Static res:Strings.CardDataAttribution}"/>
                        <Hyperlink NavigateUri="https://open-meteo.com/" RequestNavigate="OnLinkClicked">Open-Meteo.com</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.CardMinimumAltitude}"/>
                    <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="24" FontWeight="SemiBold">
                        <Run Text="{Binding Observer.MinimumAltitude, StringFormat={}{0:0.#}}"/><Run Text="°"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main planner -->
        <TabControl x:Name="Tabs" Grid.Row="3"
                    Style="{StaticResource DarkTabControlStyle}">
            <!-- Tonight (spec §4.1): sky quality of the site and the best targets for the active rig -->
            <TabItem x:Name="TonightTab" Header="{x:Static res:Strings.TabTonight}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.TonightRigCard}"/>
                                <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold" Text="{Binding Tonight.ActiveRigText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.TonightSkyCardTooltip}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.TonightSkyCard}"/>
                                <TextBlock Foreground="{StaticResource DarknessBrush}" FontSize="16" FontWeight="SemiBold" Text="{Binding Tonight.SiteSkyText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource NightCardBrush}" CornerRadius="7" Padding="14" Margin="6,0,0,0"
                                ToolTip="{x:Static res:Strings.TonightConditionsCardTooltip}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.TonightConditionsCard}"/>
                                <TextBlock Foreground="White" FontSize="16" FontWeight="SemiBold" Text="{Binding Tonight.ConditionsText}" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding Tonight.ConditionsDetailText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding Tonight.Alerts}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                Content="{x:Static res:Strings.MilkyWayOpen}" ToolTip="{x:Static res:Strings.MilkyWayOpenTooltip}"
                                Click="OnMilkyWayClicked"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static res:Strings.BestTargetsTitle}"/>
                        <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap" Text="{x:Static res:Strings.BestTargetsExplanation}"/>
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Text="{Binding Tonight.BestTargetsHint}"
                                   Visibility="{Binding Tonight.BestTargetsHint, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Tonight.BestTargets}"
                              AutomationProperties.Name="{x:Static res:Strings.BestTargetsTitle}"
                              MouseDoubleClick="OnBestTargetDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnId}" Binding="{Binding Id}" Width="90" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnType}" Binding="{Binding Type, Converter={StaticResource DisplayNameConverter}}" Width="120" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnVerdict}" Binding="{Binding VerdictText}" Width="92" ElementStyle="{StaticResource VerdictCellStyle}"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnScore}" Binding="{Binding Score}" Width="54" ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.ColumnSuggestedCapture}" Binding="{Binding RecommendedText}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Content="{x:Static res:Strings.DetailAddToPlan}"
                                                Command="{Binding DataContext.Tonight.AddToPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="PlannerTab" Header="{x:Static res:Strings.TabPlanner}" Style="{StaticResource DarkTabItemStyle}">
            <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <!-- The table scrolls horizontally when its ~1100 px of columns do not fit. -->
                        <ColumnDefinition Width="3*" MinWidth="460"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left panel: filters + table -->
                    <Border Grid.Column="0" Padding="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Filters: a WrapPanel moves them to the next line when they do not fit. -->
                            <WrapPanel Grid.Row="0" Margin="0,0,0,2">
                                <!-- Search by id, name or constellation (accent-insensitive) -->
                                <Grid Width="210" Margin="0,0,12,6">
                                    <TextBox x:Name="SearchBox" Padding="22,3,4,3" Background="{StaticResource SurfaceBrush}"
                                             AutomationProperties.Name="{x:Static res:Strings.SearchName}"
                                             Text="{Binding Targets.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:Strings.SearchTooltip}"/>
                                    <TextBlock Text="⌕" Foreground="{StaticResource NightMutedTextBrush}" Margin="7,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBlock Text="{x:Static res:Strings.SearchPlaceholder}" Foreground="{StaticResource PlaceholderTextBrush}" Margin="24,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterCatalog}"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              Width="110" Margin="0,0,12,0"
                                              AutomationProperties.Name="{x:Static res:Strings.FilterCatalogName}"
                                              ItemsSource="{Binding Targets.CatalogFilters}"
                                              DisplayMemberPath="Label" TextSearch.TextPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Targets.CatalogFilter}"/>
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterType}"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              Width="160" Margin="0,0,12,0" MaxDropDownHeight="320"
                                              AutomationProperties.Name="{x:Static res:Strings.FilterTypeName}"
                                              ItemsSource="{Binding Targets.TypeFilters}"
                                              DisplayMemberPath="Label" TextSearch.TextPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Targets.TypeFilter}"/>
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterConstellation}"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              Width="150" MaxDropDownHeight="320"
                                              AutomationProperties.Name="{x:Static res:Strings.FilterConstellation}"
                                              ItemsSource="{Binding Targets.ConstellationFilters}"
                                              DisplayMemberPath="Label" TextSearch.TextPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Targets.ConstellationFilter}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterMinimumAltitude}"
                                               ToolTip="{x:Static res:Strings.FilterMinimumAltitudeTooltip}"/>
                                    <TextBox Width="50" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.FilterMinimumAltitudeName}"
                                             Text="{Binding Observer.MinimumAltitude, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterMaximumMagnitude}"
                                               ToolTip="{x:Static res:Strings.FilterMaximumMagnitudeTooltip}"/>
                                    <TextBox Width="44" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.FilterMaximumMagnitudeName}"
                                             Text="{Binding Targets.MaximumMagnitude, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterMinimumSize}"
                                               ToolTip="{x:Static res:Strings.FilterMinimumSizeTooltip}"/>
                                    <TextBox Width="44" Margin="0,0,12,0" AutomationProperties.Name="{x:Static res:Strings.FilterMinimumSizeName}"
                                             ToolTip="{x:Static res:Strings.FilterMinimumSizeTooltip}"
                                             Text="{Binding Targets.MinimumSizeArcmin, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" Content="{x:Static res:Strings.FilterOnlyVisible}"
                                              IsChecked="{Binding Targets.OnlyVisible}"/>
                                    <CheckBox VerticalAlignment="Center" Content="{x:Static res:Strings.FilterObservableTonight}"
                                              ToolTip="{x:Static res:Strings.FilterObservableTonightTooltip}"
                                              IsChecked="{Binding Targets.OnlyObservableTonight}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.FilterVerdict}"
                                               ToolTip="{x:Static res:Strings.FilterVerdictTooltip}"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="160" Margin="0,0,12,0"
                                              AutomationProperties.Name="{x:Static res:Strings.FilterVerdict}"
                                              ItemsSource="{Binding Targets.VerdictFilters}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Targets.VerdictFilter}"/>
                                    <CheckBox VerticalAlignment="Center" Content="{x:Static res:Strings.FilterFitsFov}"
                                              ToolTip="{x:Static res:Strings.FilterFitsFovTooltip}"
                                              IsChecked="{Binding Targets.OnlyFitsFov}"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Status / errors -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                <TextBlock Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           Text="{Binding Targets.ErrorMessage}"/>
                                <!-- Invalid input warning; the table keeps the last valid calculation -->
                                <TextBlock Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Text="{Binding Targets.ValidationMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Targets.ValidationMessage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Day or twilight warning at the chosen time -->
                                <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Text="{Binding Tonight.SkyBanner}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tonight.SkyBanner}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                               Text="{Binding Targets.Objects.Count, Mode=OneWay, StringFormat={x:Static res:Strings.ShowingObjectsFormat}}"/>
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Margin="12,0,0,0" FontStyle="Italic"
                                               Text="{x:Static res:Strings.CalculatingNight}"
                                               Visibility="{Binding Targets.IsCalculatingNight, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Margin="12,0,0,0" FontStyle="Italic"
                                               Text="{x:Static res:Strings.CalculatingFeasibility}"
                                               Visibility="{Binding Targets.IsCalculatingFeasibility, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Results table -->
                            <DataGrid Grid.Row="2" Style="{StaticResource NightDataGridStyle}"
                                      ItemsSource="{Binding Targets.Objects}"
                                      SelectedItem="{Binding Targets.SelectedObject}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnObserved}" Binding="{Binding IsObserved, Converter={StaticResource ObservedMarkConverter}}" Width="26"
                                                        ElementStyle="{StaticResource ObservedCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnId}" Binding="{Binding Id}" Width="96" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    <DataGridTextColumn Binding="{Binding VerdictText}" Width="92" ElementStyle="{StaticResource VerdictCellStyle}" SortMemberPath="Score">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{x:Static res:Strings.ColumnVerdict}" ToolTip="{x:Static res:Strings.ColumnVerdictTooltip}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnScore}" Binding="{Binding Score}" Width="54" ElementStyle="{StaticResource CenteredCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnAlsoKnownAs}" Binding="{Binding CrossIdentifiers}" Width="112" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnConstellation}" Binding="{Binding Constellation}" Width="124" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnType}" Binding="{Binding Type, Converter={StaticResource DisplayNameConverter}}" Width="124" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnMagnitude}" Binding="{Binding MagnitudeText}" Width="64" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Binding="{Binding SizeText}" Width="86" ElementStyle="{StaticResource NumericCellStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{x:Static res:Strings.ColumnSize}" ToolTip="{x:Static res:Strings.ColumnSizeTooltip}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding SurfaceBrightness, StringFormat=F1}" Width="70" ElementStyle="{StaticResource NumericCellStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{x:Static res:Strings.ColumnSurfaceBrightness}" ToolTip="{x:Static res:Strings.ColumnSurfaceBrightnessTooltip}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnAltitude}" Binding="{Binding AltitudeDegrees, StringFormat=F1}" Width="70" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnAzimuth}" Binding="{Binding AzimuthDegrees, StringFormat=F1}" Width="74" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    <DataGridTextColumn Binding="{Binding MaximumAltitudeTonight, StringFormat={}{0:0}°}" Width="76" ElementStyle="{StaticResource NumericCellStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{x:Static res:Strings.ColumnMaximumAltitude}" ToolTip="{x:Static res:Strings.ColumnMaximumAltitudeTonightTooltip}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding BestWindowText}" Width="124" ElementStyle="{StaticResource NumericCellStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{x:Static res:Strings.ColumnBestWindow}" ToolTip="{x:Static res:Strings.ColumnBestWindowTooltip}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnMoon}" Binding="{Binding MoonSeparationDegrees, StringFormat={}{0:0}°}" Width="68" ElementStyle="{StaticResource MoonCellStyle}"/>
                                    <DataGridTextColumn Header="{x:Static res:Strings.ColumnStatus}" Binding="{Binding VisibilityStatus}" Width="82" ElementStyle="{StaticResource StatusCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </Border>

                    <!-- Draggable splitter between table and chart -->
                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch"
                                  Background="Transparent" Cursor="SizeWE"
                                  ResizeBehavior="PreviousAndNext" ToolTip="{x:Static res:Strings.SplitterTooltip}"/>

                    <!-- Right panel: altitude chart -->
                    <Border Grid.Column="2" Padding="8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                        Content="{x:Static res:Strings.SkyOpenFinderChart}" ToolTip="{x:Static res:Strings.SkyOpenFinderChartTooltip}"
                                        Command="{Binding Sky.OpenFinderChartCommand}" IsEnabled="{Binding Detail.HasSelection}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding Detail.ChartTitle}"/>
                            </DockPanel>
                            <ScottPlot:WpfPlot x:Name="AltitudePlot" Grid.Row="1" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SkyTab" Header="{x:Static res:Strings.TabSky}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>
                    <!-- 3D sky (WebView2 + three.js renderer, src/sky-renderer) -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Background="#050B16" ClipToBounds="True"
                            Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <sky:SkyHost x:Name="SkyHostView"/>
                    </Border>
                    <!-- Fallback without WebView2: the 2D chart of v1 -->
                    <DockPanel Grid.Column="0"
                               Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding Sky.RendererMessage}"/>
                        <Border Padding="8" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScottPlot:WpfPlot x:Name="SkyPlot" MouseLeftButtonUp="OnSkyPlotClicked"/>
                        </Border>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,4,0">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyTitle}"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.SkyHelp}"
                                       Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- View mode -->
                            <StackPanel Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyViewHeader}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6"
                                            Content="{x:Static res:Strings.SkyExportImage}" ToolTip="{x:Static res:Strings.SkyExportImageTooltip}"
                                            Click="OnSkyExportClicked"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="SkyMode" Style="{StaticResource SkyModeButtonStyle}" IsChecked="{Binding Sky.IsDomeMode}"
                                                     Content="{x:Static res:Strings.SkyViewDome}" ToolTip="{x:Static res:Strings.SkyViewDomeTooltip}"/>
                                        <RadioButton GroupName="SkyMode" Style="{StaticResource SkyModeButtonStyle}" IsChecked="{Binding Sky.IsAllSkyMode}"
                                                     Content="{x:Static res:Strings.SkyViewAllSky}" ToolTip="{x:Static res:Strings.SkyViewAllSkyTooltip}"/>
                                        <RadioButton GroupName="SkyMode" Style="{StaticResource SkyModeButtonStyle}" IsChecked="{Binding Sky.IsFinderMode}"
                                                     Content="{x:Static res:Strings.SkyViewFinder}" ToolTip="{x:Static res:Strings.SkyViewFinderTooltip}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>

                            <!-- Time control -->
                            <StackPanel Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyTimeHeader}"/>
                                <TextBlock FontSize="15" Text="{Binding Sky.SkyTimeText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="78" Command="{Binding Sky.PlayCommand}"
                                            Content="{x:Static res:Strings.SkyPlay}" ToolTip="{x:Static res:Strings.SkyPlayTooltip}"
                                            Visibility="{Binding Sky.IsPlaying, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="78" Command="{Binding Sky.PauseCommand}"
                                            Content="{x:Static res:Strings.SkyPause}" ToolTip="{x:Static res:Strings.SkyPlayTooltip}"
                                            Visibility="{Binding Sky.IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Text="{x:Static res:Strings.SkyRateLabel}"/>
                                    <ComboBox Width="70" ItemsSource="{Binding Sky.Rates}" SelectedItem="{Binding Sky.SelectedRate}"
                                              ItemStringFormat="{x:Static res:Strings.SkyRateFormat}"/>
                                    <Button Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.NowCommand}"
                                            Content="{x:Static res:Strings.SkyNow}"/>
                                </StackPanel>
                                <UniformGrid Columns="4" Margin="0,6,0,0">
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="-1440" Content="{x:Static res:Strings.SkyStepBackDay}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="-60" Content="{x:Static res:Strings.SkyStepBackHour}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="-10" Content="{x:Static res:Strings.SkyStepBackTenMinutes}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="-1" Content="{x:Static res:Strings.SkyStepBackMinute}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="1" Content="{x:Static res:Strings.SkyStepForwardMinute}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="10" Content="{x:Static res:Strings.SkyStepForwardTenMinutes}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="60" Content="{x:Static res:Strings.SkyStepForwardHour}"/>
                                    <Button Margin="0,0,3,3" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.StepCommand}" CommandParameter="1440" Content="{x:Static res:Strings.SkyStepForwardDay}"/>
                                </UniformGrid>

                                <!-- Find -->
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkySearchHeader}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Sky.SearchCommand}" Content="{x:Static res:Strings.SkySearchButton}"/>
                                    <TextBox x:Name="SkySearchBox" Text="{Binding Sky.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:Strings.SkySearchTooltip}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Sky.SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                           Text="{Binding Sky.SearchMessage}" Visibility="{Binding Sky.SearchMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                            </StackPanel>

                            <!-- Selection -->
                            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Sky.SelectedText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.CenterOnSelectionCommand}"
                                        Content="{x:Static res:Strings.SkyCenterOnSelection}" IsEnabled="{Binding Sky.HasCatalogSelection}"
                                        Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Sky.OpenDetailsCommand}"
                                        Content="{x:Static res:Strings.SkyOpenDetails}" IsEnabled="{Binding Sky.HasCatalogSelection}"/>
                            </StackPanel>
                            <Button Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding Sky.OpenFinderChartCommand}" Content="{x:Static res:Strings.SkyOpenFinderChart}"
                                    ToolTip="{x:Static res:Strings.SkyOpenFinderChartTooltip}" IsEnabled="{Binding Sky.HasCatalogSelection}"
                                    Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                       Text="{Binding Sky.HoverText, StringFormat={x:Static res:Strings.SkyHoverFormat}}"
                                       Visibility="{Binding Sky.HoverText, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <!-- Layers -->
                            <StackPanel Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyLayersHeader}"/>
                                <ItemsControl ItemsSource="{Binding Sky.LayerToggles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,2" Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,8,0,2" Text="{x:Static res:Strings.SkyStarLimit}"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Width="32" TextAlignment="Right"
                                               Text="{Binding Sky.StarLimitMagnitude, StringFormat=0.0}"/>
                                    <Slider Minimum="3" Maximum="9.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding Sky.StarLimitMagnitude, Delay=150}"/>
                                </DockPanel>
                                <CheckBox Margin="0,8,0,0" Content="{x:Static res:Strings.SkyShowStats}" IsChecked="{Binding Sky.ShowStats}"/>
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding Sky.StatsText}"
                                           Visibility="{Binding Sky.StatsText, Converter={StaticResource NullToCollapsedConverter}}"/>

                                <!-- Sky brightness -->
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyBrightnessHeader}"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding Sky.SkyBrightnessText}"
                                           Visibility="{Binding Sky.SkyBrightnessText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap" Text="{Binding Sky.SiteSqmText}"/>

                                <!-- Camera field of view -->
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyFovHeader}"/>
                                <CheckBox Content="{x:Static res:Strings.SkyFovShow}" IsChecked="{Binding Sky.IsFovVisible}"/>
                                <StackPanel Margin="0,6,0,0" IsEnabled="{Binding Sky.IsFovVisible}">
                                    <TextBlock Margin="0,0,0,2" Text="{x:Static res:Strings.SkySensorLabel}"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Sky.SensorPresets}"
                                              SelectedItem="{Binding Sky.SelectedSensorPreset}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.SkySensorWidth}"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Sky.SensorWidthMm, Delay=400, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.SkySensorHeight}"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Sky.SensorHeightMm, Delay=400, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="{x:Static res:Strings.SkyFocalLength}"/>
                                        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding Sky.FocalLengthMm, Delay=400, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" Text="{x:Static res:Strings.SkyFovRotation}"
                                                   ToolTip="{x:Static res:Strings.SkyFovRotationTooltip}"/>
                                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Sky.FovRotationDegrees, Delay=400, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{x:Static res:Strings.SkyFovRotationTooltip}"/>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding Sky.FovText}" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                               Text="{Binding Sky.FovRigName, StringFormat={x:Static res:Strings.SkyFovFromRigFormat}}"
                                               Visibility="{Binding Sky.FovRigName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding Sky.FovCenterText}"
                                               Visibility="{Binding Sky.FovCenterText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.SkyFovHelp}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Legend of the 2D fallback chart -->
                            <StackPanel Visibility="{Binding Sky.IsRendererAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.SkyExplanation}"/>
                                <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{x:Static res:Strings.SkyLegend}"/>
                                <TextBlock Foreground="{StaticResource AccentBrush}" Text="{x:Static res:Strings.SkyLegendVisible}"/>
                                <TextBlock Foreground="{StaticResource PlaceholderTextBrush}" Text="{x:Static res:Strings.SkyLegendBelow}"/>
                                <TextBlock Foreground="{StaticResource WarningBrush}" Text="{x:Static res:Strings.SkyLegendInPlan}"/>
                                <TextBlock Foreground="White" Text="{x:Static res:Strings.SkyLegendSelected}"/>
                                <TextBlock Foreground="{StaticResource MoonBrush}" Text="{x:Static res:Strings.SkyLegendMoon}"/>
                                <TextBlock Foreground="{StaticResource PlanetBrush}" Text="{x:Static res:Strings.SkyLegendPlanet}"/>
                                <TextBlock Foreground="{StaticResource WarningBrush}" Text="{x:Static res:Strings.SkyLegendMinimumAltitude}"/>
                                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.SkyFiltersNote}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="DetailTab" Header="{x:Static res:Strings.TabDetail}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="16">
                    <TextBlock Text="{x:Static res:Strings.DetailEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource NightMutedTextBrush}"
                               FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Padding="18" Background="{StaticResource NightPanelBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail.HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid DataContext="{Binding Detail.Observation}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Target.Id}"/>
                                <!-- For planets the id already is the name: do not repeat it -->
                                <TextBlock Margin="10,0,0,0" FontSize="24" Text="{Binding Target.CommonName}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsPlanet, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,18"
                                       Foreground="{StaticResource NightMutedTextBrush}"
                                       Text="{Binding Target.Type, Converter={StaticResource DisplayNameConverter}, StringFormat={x:Static res:Strings.DetailTypeFormat}}"/>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailAstronomicalInfo}"/>
                                <TextBlock Margin="0,6,0,0" Text="{Binding Constellation, StringFormat={x:Static res:Strings.DetailConstellationFormat}}"/>
                                <TextBlock Text="{Binding Magnitude, StringFormat={x:Static res:Strings.DetailMagnitudeFormat}}"/>
                                <TextBlock Text="{Binding SizeText}" Visibility="{Binding SizeText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Text="{Binding SurfaceBrightnessText}" Visibility="{Binding SurfaceBrightnessText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Text="{Binding DesignationsText}" TextWrapping="Wrap" Margin="0,0,12,0"
                                           Visibility="{Binding DesignationsText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <TextBlock Text="{Binding MaximumAltitudeDegrees, StringFormat={x:Static res:Strings.DetailMaximumAltitudeFormat}}"/>
                                <!-- Planets only: values that change with the date -->
                                <StackPanel Visibility="{Binding IsPlanet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Planet.DistanceAu, StringFormat={x:Static res:Strings.DetailDistanceFormat}}"/>
                                    <TextBlock Text="{Binding Planet.ApparentDiameterArcsec, StringFormat={x:Static res:Strings.DetailApparentSizeFormat}}"/>
                                    <TextBlock Text="{Binding Planet.IlluminatedFraction, StringFormat={x:Static res:Strings.DetailPhaseFormat}}"/>
                                    <TextBlock Text="{Binding Planet.ElongationDegrees, StringFormat={x:Static res:Strings.DetailElongationFormat}}"/>
                                </StackPanel>
                                <!-- Comets and asteroids: distances and where the orbit comes from -->
                                <TextBlock Text="{Binding SmallBodyText}" TextWrapping="Wrap" Margin="0,0,12,0"
                                           Visibility="{Binding SmallBodyText, Converter={StaticResource NullToCollapsedConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailCurrentPosition}"/>
                                <TextBlock Margin="0,6,0,0" Text="{Binding Coordinates.AltitudeDegrees, StringFormat={x:Static res:Strings.DetailAltitudeFormat}}"/>
                                <TextBlock Text="{Binding Coordinates.AzimuthDegrees, StringFormat={x:Static res:Strings.DetailAzimuthFormat}}"/>
                                <TextBlock Text="{Binding VisibilityStatus, StringFormat={x:Static res:Strings.DetailStatusFormat}}"/>
                                <TextBlock Text="{Binding MoonSeparationDegrees, StringFormat={x:Static res:Strings.DetailMoonDistanceFormat}}"/>
                                <TextBlock Margin="0,8,12,0" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{Binding MoonWarning}"
                                           Visibility="{Binding HasMoonWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailNightEvents}"/>
                                <TextBlock Margin="0,6,0,0" Text="{Binding RiseTimeLocal, StringFormat={x:Static res:Strings.DetailRiseFormat}, TargetNullValue={x:Static res:Strings.DetailRiseNone}}"/>
                                <TextBlock Text="{Binding VisibilityStartTimeLocal, StringFormat={x:Static res:Strings.DetailThresholdFormat}, TargetNullValue={x:Static res:Strings.DetailThresholdNone}}"/>
                                <TextBlock Text="{Binding BestObservationTimeLocal, StringFormat={x:Static res:Strings.DetailCulminationFormat}}"/>
                                <TextBlock Text="{Binding SetTimeLocal, StringFormat={x:Static res:Strings.DetailSetFormat}, TargetNullValue={x:Static res:Strings.DetailSetNone}}"/>
                                <TextBlock Text="{Binding CloudCoverAtCulmination, StringFormat={x:Static res:Strings.DetailCloudsFormat}, TargetNullValue={x:Static res:Strings.DetailCloudsNone}}"/>
                                <TextBlock Text="{Binding BestWindowText}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.DetailAddToPlan}"
                                            Command="{Binding DataContext.Detail.AddToPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.DetailRemoveFromPlan}"
                                            Command="{Binding DataContext.Detail.RemoveFromPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsEnabled="{Binding DataContext.Detail.IsInPlan, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.DetailLogObservation}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="{x:Static res:Strings.DetailLogObservationTooltip}"
                                        Click="OnLogObservationClicked"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.SkyOpenFinderChart}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        ToolTip="{x:Static res:Strings.SkyOpenFinderChartTooltip}"
                                        Command="{Binding DataContext.Sky.OpenFinderChartCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <!-- Capture feasibility (spec §8.6): every factor with its value and impact -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,20,0,0"
                                        DataContext="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailFeasibilityTitle}"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource NightMutedTextBrush}"
                                           Text="{x:Static res:Strings.DetailFeasibilityNone}"
                                           Visibility="{Binding HasFeasibility, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <StackPanel Visibility="{Binding HasFeasibility, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding FeasibilityHeadline}"/>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource SuccessSoftBrush}" Text="{Binding RecommendedText}"
                                               Visibility="{Binding RecommendedText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding FeasibilityLines}"
                                                  AutomationProperties.Name="{x:Static res:Strings.DetailFeasibilityTitle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1" TextWrapping="Wrap" Text="{Binding Text, StringFormat=• {0}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PlaceholderTextBrush}"
                                               Text="{x:Static res:Strings.DetailFeasibilityDisclaimer}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Online information (spec §4.4): framing preview from survey tiles and the Wikipedia description -->
                            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0"
                                            DataContext="{Binding DataContext.Detail.Framing, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailFramingTitle}"
                                               ToolTip="{x:Static res:Strings.DetailFramingTooltip}"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding FieldText}"
                                               Visibility="{Binding FieldText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{x:Static res:Strings.FramingSurvey}"/>
                                        <ComboBox Width="190" VerticalAlignment="Center" ItemsSource="{Binding Surveys}" SelectedItem="{Binding SelectedSurvey}"
                                                  DisplayMemberPath="Name" AutomationProperties.Name="{x:Static res:Strings.FramingSurvey}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="16,0,6,0" Text="{x:Static res:Strings.FramingRotation}"/>
                                        <Slider Width="160" VerticalAlignment="Center" Minimum="0" Maximum="355" SmallChange="5" LargeChange="15"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RotationDegrees}"
                                                ToolTip="{x:Static res:Strings.FramingRotationTooltip}"
                                                AutomationProperties.Name="{x:Static res:Strings.FramingRotation}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Text="{Binding RotationDegrees, StringFormat={x:Static res:Strings.FramingRotationFormat}}"/>
                                    </WrapPanel>
                                    <Viewbox Margin="0,8,0,0" MaxHeight="420" HorizontalAlignment="Left" Stretch="Uniform"
                                             Visibility="{Binding Image, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Grid Width="{Binding Image.Width}" Height="{Binding Image.Height}" ClipToBounds="True">
                                            <Image Source="{Binding Image, Converter={StaticResource RgbImageConverter}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   AutomationProperties.Name="{x:Static res:Strings.DetailFramingTitle}"/>
                                            <Canvas Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Ellipse Canvas.Left="{Binding OutlineLeft}" Canvas.Top="{Binding OutlineTop}"
                                                         Width="{Binding OutlineWidth}" Height="{Binding OutlineHeight}"
                                                         Stroke="{StaticResource WarningBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="{Binding OutlineAngle}"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding StatusText}"
                                               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PlaceholderTextBrush}"
                                               Text="{Binding AttributionText}"
                                               Visibility="{Binding AttributionText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            DataContext="{Binding DataContext.Detail.About, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Foreground="{StaticResource NightMutedTextBrush}" Text="{x:Static res:Strings.DetailInfoTitle}"/>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding StatusText}"
                                               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <StackPanel Visibility="{Binding HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Summary.Title}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding Summary.Description}"/>
                                        <Image Margin="0,8,0,0" MaxHeight="220" HorizontalAlignment="Left" Stretch="Uniform"
                                               Source="{Binding ImageContent, Converter={StaticResource ImageBytesConverter}}"
                                               Visibility="{Binding ImageContent, Converter={StaticResource NullToCollapsedConverter}}"
                                               AutomationProperties.Name="{Binding Summary.Image.FileName}"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PlaceholderTextBrush}"
                                                   Text="{Binding ImageCreditText}"
                                                   Visibility="{Binding ImageCreditText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Summary.Extract}"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource PlaceholderTextBrush}"
                                                   Text="{x:Static res:Strings.InfoTextCredit}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.InfoOpenArticle}"
                                                    Command="{Binding OpenArticleCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.InfoOpenImage}"
                                                    Command="{Binding OpenImagePageCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.InfoOpenLicense}"
                                                    Command="{Binding OpenLicenseCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="PlanTab" Header="{x:Static res:Strings.TabPlan}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="140"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: priorities, exports and print -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.PlanAutoPrioritize}" Margin="0,0,8,0"
                                    ToolTip="{x:Static res:Strings.PlanAutoPrioritizeTooltip}"
                                    Command="{Binding Plan.AutoPrioritizeCommand}"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.PlanExportCsv}" Margin="0,0,8,0"
                                    ToolTip="{x:Static res:Strings.PlanExportTooltip}"
                                    Click="OnExportPlanClicked"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.PlanExportPdf}" Margin="0,0,8,0"
                                    ToolTip="{x:Static res:Strings.PlanExportPdfTooltip}"
                                    Click="OnExportPlanPdfClicked"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.PlanExportIcs}" Margin="0,0,8,0"
                                    ToolTip="{x:Static res:Strings.PlanExportIcsTooltip}"
                                    Click="OnExportPlanIcsClicked"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.PlanPrint}"
                                    ToolTip="{x:Static res:Strings.PlanPrintTooltip}"
                                    Click="OnPrintPlanClicked"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.PlanExplanation}"/>
                            <TextBlock Foreground="{StaticResource SuccessSoftBrush}" Text="{Binding Plan.StatusMessage}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Margin="0,0,0,6" Text="{Binding Plan.ScheduleSummary}" TextWrapping="Wrap"
                               Foreground="{StaticResource NightTextBrush}" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="{x:Static res:Strings.PlanEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource NightMutedTextBrush}" FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Plan.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Timeline (drawn by the code-behind from Plan.Timeline) -->
                    <Border Grid.Row="2" Margin="0,0,0,8" Padding="4" Background="{StaticResource NightPanelBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Plan.Timeline}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScottPlot:WpfPlot x:Name="TimelinePlot" AutomationProperties.Name="{x:Static res:Strings.PlanTimelineTitle}"/>
                    </Border>

                    <Border Grid.Row="3" Padding="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Plan.Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DataGrid Style="{StaticResource NightDataGridStyle}"
                                  ItemsSource="{Binding Plan.Items}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Priority}" Width="34" ElementStyle="{StaticResource NumericCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{x:Static res:Strings.ColumnPriority}" ToolTip="{x:Static res:Strings.ColumnPriorityTooltip}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="62">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GridButtonStyle}" Content="{x:Static res:Strings.PlanMoveUp}" Padding="6,0" Margin="0,0,2,0"
                                                        ToolTip="{x:Static res:Strings.PlanMoveUpTooltip}" AutomationProperties.Name="{x:Static res:Strings.PlanMoveUpTooltip}"
                                                        Command="{Binding DataContext.Plan.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GridButtonStyle}" Content="{x:Static res:Strings.PlanMoveDown}" Padding="6,0"
                                                        ToolTip="{x:Static res:Strings.PlanMoveDownTooltip}" AutomationProperties.Name="{x:Static res:Strings.PlanMoveDownTooltip}"
                                                        Command="{Binding DataContext.Plan.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnLock}" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding HasBlock}"
                                                      ToolTip="{x:Static res:Strings.PlanLockTooltip}" AutomationProperties.Name="{x:Static res:Strings.PlanLockName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnStart}" Binding="{Binding StartLocal, StringFormat=HH:mm}" Width="52"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnEnd}" Binding="{Binding EndLocal, StringFormat=HH:mm}" Width="52"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnId}" Binding="{Binding Row.Id}" Width="80" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Row.Name}" Width="150" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnVerdict}" Binding="{Binding VerdictText}" Width="80" ElementStyle="{StaticResource VerdictCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSubs}" Binding="{Binding SubsText}" Width="150" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnIntegration}" Binding="{Binding IntegrationText}" Width="76"/>
                                <DataGridTextColumn Binding="{Binding MeridianFlipLocal, StringFormat=HH:mm}" Width="48">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{x:Static res:Strings.ColumnMeridianFlip}" ToolTip="{x:Static res:Strings.ColumnMeridianFlipTooltip}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnStatus}" Binding="{Binding StatusText}" Width="110" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnCulmination}" Binding="{Binding CulminationLocal, StringFormat=HH:mm}" Width="80"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnMaximumAltitude}" Binding="{Binding MaximumAltitudeDegrees, StringFormat={}{0:0}°}" Width="66" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnClouds}" Binding="{Binding CloudCoverAtCulmination, StringFormat={x:Static res:Strings.PercentFormat}, TargetNullValue='—'}" Width="58" ElementStyle="{StaticResource NumericCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnMoon}" Binding="{Binding Row.MoonSeparationDegrees, StringFormat={}{0:0}°}" Width="52" ElementStyle="{StaticResource PlanMoonCellStyle}"/>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnNotes}" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                                     BorderBrush="{StaticResource GridLineBrush}" Padding="4,1"
                                                     AutomationProperties.Name="{x:Static res:Strings.PlanNoteName}"
                                                     ToolTip="{x:Static res:Strings.PlanNoteTooltip}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GridButtonStyle}" Content="{x:Static res:Strings.PlanRemove}"
                                                    Command="{Binding DataContext.Plan.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Checklist (spec §4.6) -->
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource NightTextBrush}" Text="{x:Static res:Strings.ChecklistTitle}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.ChecklistReset}"
                                ToolTip="{x:Static res:Strings.ChecklistResetTooltip}" Command="{Binding Plan.ResetChecklistCommand}"/>
                        <ItemsControl ItemsSource="{Binding Plan.Checklist}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,2,16,2" Content="{Binding Text}" IsChecked="{Binding IsDone}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabLogbook}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12" DataContext="{Binding Logbook}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Messier marathon progress and export -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.PlanExportCsv}"
                                ToolTip="{x:Static res:Strings.LogbookExportTooltip}"
                                Click="OnExportLogbookClicked"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Static res:Strings.LogbookMessierMarathon}"/>
                                <TextBlock FontSize="16" Margin="10,0,0,0" Foreground="{StaticResource SuccessSoftBrush}" FontWeight="SemiBold"
                                           Text="{Binding MessierProgressText}"/>
                            </StackPanel>
                            <ProgressBar Width="360" Height="8" Margin="0,6,0,0" HorizontalAlignment="Left"
                                         Minimum="0" Maximum="100" Value="{Binding MessierProgressPercent, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Static res:Strings.LogbookMessierProgressName}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.CatalogCaldwell}"/>
                                <TextBlock FontSize="14" Margin="10,0,0,0" Foreground="{StaticResource SuccessSoftBrush}" FontWeight="SemiBold"
                                           Text="{Binding CaldwellProgressText}"/>
                            </StackPanel>
                            <ProgressBar Width="360" Height="6" Margin="0,4,0,0" HorizontalAlignment="Left"
                                         Minimum="0" Maximum="100" Value="{Binding CaldwellProgressPercent, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Static res:Strings.LogbookCaldwellProgressName}"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.LogbookExplanation}"/>
                            <TextBlock Foreground="{StaticResource SuccessSoftBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.LogbookEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource NightMutedTextBrush}" FontSize="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="1" Padding="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Entries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnDate}" Binding="{Binding ObservedAtLocal, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnId}" Binding="{Binding ObjectId}" Width="66"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding ObjectName}" Width="190" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnLocation}" Binding="{Binding Location}" Width="150" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnEquipment}" Binding="{Binding Equipment}" Width="150" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSeeing}" Binding="{Binding Seeing}" Width="60" ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnTransparency}" Binding="{Binding Transparency}" Width="64" ElementStyle="{StaticResource CenteredCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnRating}" Binding="{Binding RatingStars}" Width="86">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnNotes}" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTemplateColumn Width="86">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GridButtonStyle}" Content="{x:Static res:Strings.LogbookDelete}"
                                                    Command="{Binding DataContext.Logbook.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Equipment inventory and rigs (spec §4.5) -->
            <TabItem x:Name="EquipmentTab" Header="{x:Static res:Strings.TabEquipment}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12" DataContext="{Binding Equipment}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap" Text="{x:Static res:Strings.EquipmentExplanation}"/>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding StatusMessage}"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessSoftBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TabControl Grid.Row="1" Style="{StaticResource DarkTabControlStyle}">
                        <!-- Rigs -->
                        <TabItem Header="{x:Static res:Strings.EquipmentRigs}" Style="{StaticResource DarkTabItemStyle}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Rigs}" SelectedItem="{Binding SelectedRig}"
                                          AutomationProperties.Name="{x:Static res:Strings.EquipmentRigs}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnFocal}" Binding="{Binding FocalLengthMm, StringFormat={}{0:0} mm}" Width="70" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldName}"/>
                                        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding RigName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldName}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.EquipmentCamera}"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="320" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="{x:Static res:Strings.EquipmentCamera}"
                                                  ItemsSource="{Binding Cameras}" DisplayMemberPath="Name" SelectedItem="{Binding RigCamera}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.EquipmentOptic}"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="320" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="{x:Static res:Strings.EquipmentOptic}"
                                                  ItemsSource="{Binding Optics}" DisplayMemberPath="Name" SelectedItem="{Binding RigOptic}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.EquipmentMount}"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="320" HorizontalAlignment="Left"
                                                  AutomationProperties.Name="{x:Static res:Strings.EquipmentMount}"
                                                  ItemsSource="{Binding Mounts}" DisplayMemberPath="Name" SelectedItem="{Binding RigMount}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.FieldFocalMultiplier}" ToolTip="{x:Static res:Strings.FieldFocalMultiplierTooltip}"/>
                                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding FocalMultiplierText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{x:Static res:Strings.FieldFocalMultiplier}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.FieldNotes}"/>
                                        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding RigNotes}" AutomationProperties.Name="{x:Static res:Strings.FieldNotes}"/>
                                        <Border Margin="0,12,0,0" Padding="10" Background="{StaticResource NightCardBrush}" CornerRadius="6" MaxWidth="640" HorizontalAlignment="Left">
                                            <TextBlock TextWrapping="Wrap" Text="{Binding DerivedText}" Foreground="{StaticResource LabelTextBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.EquipmentSave}" Command="{Binding SaveRigCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentNew}" Command="{Binding NewRigCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentActivate}" Command="{Binding ActivateRigCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentDelete}" Command="{Binding DeleteRigCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Cameras -->
                        <TabItem Header="{x:Static res:Strings.EquipmentCameras}" Style="{StaticResource DarkTabItemStyle}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                          AutomationProperties.Name="{x:Static res:Strings.EquipmentCameras}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldName}"/>
                                        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding CameraName}" AutomationProperties.Name="{x:Static res:Strings.FieldName}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldCameraKind}"/>
                                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="150" ItemsSource="{Binding CameraKinds}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" SelectedValue="{Binding CameraKindValue}" AutomationProperties.Name="{x:Static res:Strings.FieldCameraKind}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldSensorColor}"/>
                                                <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="190" ItemsSource="{Binding SensorColors}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" SelectedValue="{Binding CameraColorValue}" AutomationProperties.Name="{x:Static res:Strings.FieldSensorColor}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldSensorWidthMm}"/>
                                                <TextBox Width="100" Text="{Binding SensorWidthText}" AutomationProperties.Name="{x:Static res:Strings.FieldSensorWidthMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldSensorHeightMm}"/>
                                                <TextBox Width="100" Text="{Binding SensorHeightText}" AutomationProperties.Name="{x:Static res:Strings.FieldSensorHeightMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldResolutionWidth}"/>
                                                <TextBox Width="100" Text="{Binding ResolutionWidthText}" AutomationProperties.Name="{x:Static res:Strings.FieldResolutionWidth}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldResolutionHeight}"/>
                                                <TextBox Width="100" Text="{Binding ResolutionHeightText}" AutomationProperties.Name="{x:Static res:Strings.FieldResolutionHeight}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldPixelSizeUm}" ToolTip="{x:Static res:Strings.FieldPixelSizeTooltip}"/>
                                                <TextBox Width="100" Text="{Binding PixelSizeText}" AutomationProperties.Name="{x:Static res:Strings.FieldPixelSizeUm}"
                                                         ToolTip="{x:Static res:Strings.FieldPixelSizeTooltip}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldQeFraction}" ToolTip="{x:Static res:Strings.FieldNoiseTooltip}"/>
                                                <TextBox Width="100" Text="{Binding QuantumEfficiencyText}" AutomationProperties.Name="{x:Static res:Strings.FieldQeFraction}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldReadNoiseE}" ToolTip="{x:Static res:Strings.FieldNoiseTooltip}"/>
                                                <TextBox Width="100" Text="{Binding ReadNoiseText}" AutomationProperties.Name="{x:Static res:Strings.FieldReadNoiseE}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldDarkCurrentE}" ToolTip="{x:Static res:Strings.FieldNoiseTooltip}"/>
                                                <TextBox Width="100" Text="{Binding DarkCurrentText}" AutomationProperties.Name="{x:Static res:Strings.FieldDarkCurrentE}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldIso}"/>
                                                <TextBox Width="100" Text="{Binding IsoText}" AutomationProperties.Name="{x:Static res:Strings.FieldIso}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldGain}"/>
                                                <TextBox Width="100" Text="{Binding GainText}" AutomationProperties.Name="{x:Static res:Strings.FieldGain}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldNotes}"/>
                                        <TextBox Width="420" HorizontalAlignment="Left" Text="{Binding CameraNotes}" TextWrapping="Wrap" AutomationProperties.Name="{x:Static res:Strings.FieldNotes}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.EquipmentSave}" Command="{Binding SaveCameraCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentNew}" Command="{Binding NewCameraCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentDelete}" Command="{Binding DeleteCameraCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Optics -->
                        <TabItem Header="{x:Static res:Strings.EquipmentOptics}" Style="{StaticResource DarkTabItemStyle}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Optics}" SelectedItem="{Binding SelectedOptic}"
                                          AutomationProperties.Name="{x:Static res:Strings.EquipmentOptics}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnFocal}" Binding="{Binding FocalLengthMm, StringFormat={}{0:0} mm}" Width="70" ElementStyle="{StaticResource NumericCellStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldName}"/>
                                        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding OpticName}" AutomationProperties.Name="{x:Static res:Strings.FieldName}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.FieldOpticKind}"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding OpticKinds}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding OpticKindValue}" AutomationProperties.Name="{x:Static res:Strings.FieldOpticKind}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldFocalLengthMm}"/>
                                                <TextBox Width="100" Text="{Binding FocalLengthText}" AutomationProperties.Name="{x:Static res:Strings.FieldFocalLengthMm}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldApertureMm}" ToolTip="{x:Static res:Strings.FieldApertureTooltip}"/>
                                                <TextBox Width="100" Text="{Binding ApertureText}" AutomationProperties.Name="{x:Static res:Strings.FieldApertureMm}"
                                                         ToolTip="{x:Static res:Strings.FieldApertureTooltip}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldFocalRatioShort}" ToolTip="{x:Static res:Strings.FieldApertureTooltip}"/>
                                                <TextBox Width="100" Text="{Binding FocalRatioText}" AutomationProperties.Name="{x:Static res:Strings.FieldFocalRatioShort}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldTransmissionFraction}"/>
                                                <TextBox Width="100" Text="{Binding TransmissionText}" AutomationProperties.Name="{x:Static res:Strings.FieldTransmissionFraction}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldNotes}"/>
                                        <TextBox Width="420" HorizontalAlignment="Left" Text="{Binding OpticNotes}" AutomationProperties.Name="{x:Static res:Strings.FieldNotes}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.EquipmentSave}" Command="{Binding SaveOpticCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentNew}" Command="{Binding NewOpticCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentDelete}" Command="{Binding DeleteOpticCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Mounts -->
                        <TabItem Header="{x:Static res:Strings.EquipmentMounts}" Style="{StaticResource DarkTabItemStyle}">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Mounts}" SelectedItem="{Binding SelectedMount}"
                                          AutomationProperties.Name="{x:Static res:Strings.EquipmentMounts}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnName}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldName}"/>
                                        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding MountName}" AutomationProperties.Name="{x:Static res:Strings.FieldName}"/>
                                        <TextBlock Margin="0,8,0,0" Text="{x:Static res:Strings.FieldMountKind}"/>
                                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="240" HorizontalAlignment="Left" ItemsSource="{Binding MountKinds}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding MountKindValue}" AutomationProperties.Name="{x:Static res:Strings.FieldMountKind}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldMaxExposureS}" ToolTip="{x:Static res:Strings.FieldMaxExposureTooltip}"/>
                                                <TextBox Width="100" Text="{Binding MaxExposureText}" AutomationProperties.Name="{x:Static res:Strings.FieldMaxExposureS}"
                                                         ToolTip="{x:Static res:Strings.FieldMaxExposureTooltip}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,8">
                                                <TextBlock Text="{x:Static res:Strings.FieldPayloadKg}"/>
                                                <TextBox Width="100" Text="{Binding PayloadText}" AutomationProperties.Name="{x:Static res:Strings.FieldPayloadKg}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{x:Static res:Strings.FieldNotes}"/>
                                        <TextBox Width="420" HorizontalAlignment="Left" Text="{Binding MountNotes}" AutomationProperties.Name="{x:Static res:Strings.FieldNotes}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.EquipmentSave}" Command="{Binding SaveMountCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentNew}" Command="{Binding NewMountCommand}"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.EquipmentDelete}" Command="{Binding DeleteMountCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.TabLocations}" Style="{StaticResource DarkTabItemStyle}">
                <Grid Margin="12" DataContext="{Binding Locations}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Save the site in use -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{x:Static res:Strings.LocationsHint}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FilterLabelStyle}" Text="{x:Static res:Strings.LocationsNewName}"/>
                            <TextBox Width="200" Margin="0,0,8,0" AutomationProperties.Name="{x:Static res:Strings.LocationsNewNameName}"
                                     Text="{Binding NewLocationName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.LocationsSaveCurrent}"
                                    ToolTip="{x:Static res:Strings.LocationsSaveCurrentTooltip}"
                                    Command="{Binding SaveCurrentCommand}"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <DataGrid Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding IsActive, Converter={StaticResource ActiveMarkConverter}}" Width="26"
                                                    ElementStyle="{StaticResource ObservedCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{x:Static res:Strings.LocationsActiveMark}" ToolTip="{x:Static res:Strings.LocationsActiveTooltip}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnLocationName}" Binding="{Binding Name}" Width="200" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnCoordinates}" Binding="{Binding CoordinatesText}" Width="170"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnElevation}" Binding="{Binding ElevationText}" Width="90" ElementStyle="{StaticResource PaddedNumericCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnTimeZone}" Binding="{Binding TimeZoneText}" Width="170" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnHorizon}" Binding="{Binding HorizonText}" Width="80"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSqm}" Binding="{Binding SqmText}" Width="90"/>
                                <DataGridTextColumn Header="{x:Static res:Strings.ColumnNotesLocation}" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource TrimmedCellStyle}"/>
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,6,0"
                                                        Content="{x:Static res:Strings.LocationsUse}" ToolTip="{x:Static res:Strings.LocationsUseTooltip}"
                                                        Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,2"
                                                        Content="{x:Static res:Strings.LocationsDelete}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Details of the selected site: horizon profile and SQM -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource NightBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.LocationsDetailsHeader}"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.LocationsDetailsHint}"/>
                            <Grid Margin="0,8,0,0" Height="230" IsEnabled="{Binding HasSelection}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="270"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0" Padding="8,4"
                                                Content="{x:Static res:Strings.LocationsAddPoint}" Command="{Binding AddHorizonPointCommand}"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                                Content="{x:Static res:Strings.LocationsFlatHorizon}" Command="{Binding ClearHorizonCommand}"/>
                                    </StackPanel>
                                    <DataGrid x:Name="HorizonPointsGrid" Style="{StaticResource NightDataGridStyle}" ItemsSource="{Binding HorizonPoints}"
                                              IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{x:Static res:Strings.LocationsHorizonAzimuth}" Width="*"
                                                                Binding="{Binding Azimuth, UpdateSourceTrigger=LostFocus}"/>
                                            <DataGridTextColumn Header="{x:Static res:Strings.LocationsHorizonAltitude}" Width="*"
                                                                Binding="{Binding Altitude, UpdateSourceTrigger=LostFocus}"/>
                                            <DataGridTemplateColumn Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SecondaryButtonStyle}" Padding="6,1"
                                                                Content="{x:Static res:Strings.LocationsRemovePoint}"
                                                                Command="{Binding DataContext.RemoveHorizonPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                                <ScottPlot:WpfPlot x:Name="HorizonPlot" Grid.Column="1" Margin="10,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:Strings.LocationsSqmLabel}" ToolTip="{x:Static res:Strings.LocationsSqmTooltip}"/>
                                    <TextBox x:Name="SqmBox" Margin="0,4,0,0" Width="110" HorizontalAlignment="Left"
                                             Text="{Binding ZenithSqmText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:Strings.LocationsSqmTooltip}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource NightMutedTextBrush}" Text="{Binding BortleText}"
                                               Visibility="{Binding BortleText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                               Text="{Binding AtlasSqmText}"
                                               Visibility="{Binding AtlasSqmText, Converter={StaticResource NullToCollapsedConverter}}"/>
                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource NightMutedTextBrush}" TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.LocationsSqmTooltip}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                                Content="{x:Static res:Strings.LocationsSaveDetails}" Command="{Binding SaveDetailsCommand}"/>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{x:Static res:Strings.LocationsRevertDetails}" Command="{Binding RevertDetailsCommand}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DetailsMessage}"
                                               Visibility="{Binding DetailsMessage, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailsHasError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
