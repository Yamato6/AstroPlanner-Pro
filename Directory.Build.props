<Project>

  <!-- Shared build settings for every project in the repository. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Authors>Yamato6</Authors>
    <Company>Yamato6</Company>
    <Product>AstroPlanner Pro</Product>
    <Copyright>© 2026 Yamato6. MIT License.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- English only for now: no satellite resource folders next to the executable. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
