<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: writes the TypeScript side of the app channel (zod schemas and types) from
       the C# contracts in AstroPlanner.SkyBridge/App (docs/bridge.md). Never shipped. A test in
       AstroPlanner.SkyBridge.Tests fails while the generated file is stale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AstroPlanner.SkyBridge\AstroPlanner.SkyBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstroPlanner.SkyBridge.Tests" />
  </ItemGroup>

</Project>
